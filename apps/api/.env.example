# PostgreSQL connection string (same DB the Express server used)
POSTGRES_URL=postgresql://postgres@localhost:5432/training

# Server port (default 8080 to match the old Express server)
PORT=8080

# Enable dev auth via the `x-user-email` header and seed dev accounts.
ALLOW_DEV_AUTH_HEADERS=true

# Google OAuth client id for production sign-in (leave blank in dev).
GOOGLE_CLIENT_ID=

# AWS region for the Bedrock-hosted Claude model used by the RAG coach.
# Credentials resolve via the standard AWS chain (env vars, SSO, instance role).
AWS_REGION=us-east-1

# Bedrock model for the RAG coach. Default is Claude 3.5 Haiku (cheapest).
# Bump to a Sonnet inference profile for higher quality if needed.
RAG_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Path to the built React client (served as static + SPA fallback).
# Defaults to ../web/dist/client relative to this app.
# CLIENT_DIR=
