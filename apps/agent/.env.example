# Provider: anthropic (paid) | groq (free tier) | ollama (local, free)
LLM_PROVIDER=anthropic

# Optional: override the default model for the selected provider.
# Defaults: anthropic=claude-sonnet-4-6, groq=llama-3.3-70b-versatile, ollama=llama3.2
LLM_MODEL=

# --- anthropic ---
ANTHROPIC_API_KEY=

# --- groq (free tier at console.groq.com) ---
GROQ_API_KEY=

# --- ollama (run `ollama serve` locally) ---
OLLAMA_BASE_URL=http://localhost:11434
